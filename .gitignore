# Local agent/editor state
.claude/
.agents/

# Generated validation output
*.log

# Backups, snapshots and unused assets (internal dev history, not for public repo)
_backups/
_snapshots/
_unused_assets/
tmp_*

# Remotion dependencies and renders
remotion-eyes/node_modules/
remotion-eyes/out/
remotion-eyes/build/

# Operating-system noise
Thumbs.db
Desktop.ini
.DS_Store

# Root deps (jimp devDep)
/node_modules/

# Environment / secrets (none currently present, guard against future additions)
.env
.env.*
*.pem
*.key

# Stray backup-named files (safety net; canonical backups live outside the repo)
**/*_backup_*
